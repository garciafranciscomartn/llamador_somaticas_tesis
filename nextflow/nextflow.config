// ============================================================
// nextflow.config – Global pipeline configuration
// ============================================================

// ── Default parameters ──────────────────────────────────────
params {

    // Sample sheet: TSV with columns  sample_id  bam_path  [group]
    samples = "${projectDir}/config/samples.tsv"

    // Output directory
    outdir  = "${launchDir}/results"

    // Reference files (hg38)
    genome            = '$hg38Ref'
    germline_resource = '$somatic-hg38_af-only-gnomad.hg38.vcf.gz'
    panel_of_normals  = '$somatic-hg38_1000g_pon.hg38.vcf.gz'
    bed               = '$bedfile.bed'
    intervals         = '$bedfile.interval_list'

    // Mutect2
    mutect2_extra = '--af-of-alleles-not-in-resource 0.0000025'

    // VarScan2
    varscan_min_coverage    = 10
    varscan_min_var_freq    = 0.01
    varscan_p_value         = 0.99
    varscan_somatic_p_value = 0.05

    // VarDict
    vardict_min_af = 0.01

    // Consensus: comma-separated list of callers to use
    consensus_callers     = 'mutect2,varscan2,vardict,strelka2'
    // Minimum number of callers that must agree to call a consensus variant
    consensus_min_callers = 2

    // Strelka2 binary paths
    strelka2_bin = '$strelka-2.9.10.centos6_x86_64/bin'
    manta_bin    = '$manta-1.6.0.centos6_x86_64/bin'
    // Set to true to run Manta first and pass indel candidates to Strelka2
    strelka2_run_manta = false

    // Frequency filter
    // Keep variants found in >= min_frequency of cross-group pairwise comparisons.
    // Cross-group: pseudo-normal belongs to a DIFFERENT group than the tumor.
    // 0.75 = the variant must appear in ≥75% of those comparisons.
    min_frequency = 0.75
}

// ── Resource labels ─────────────────────────────────────────
process {
    withLabel: 'mutect2' {
        cpus   = 8
        memory = '20 GB'
    }
    withLabel: 'pileup' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'gatk_default' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'varscan2' {
        cpus   = 2
        memory = '8 GB'
    }
    withLabel: 'vardict' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'strelka2' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '8 GB'
    }
    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
    }
}

// ── Profiles ────────────────────────────────────────────────
profiles {

    local {
        process.executor = 'local'
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'default'
    }

    test {
        params.samples = "${projectDir}/config/samples.tsv"
        process.cpus   = 2
        process.memory = '8 GB'
    }
}

// ── Reports ─────────────────────────────────────────────────
report {
    enabled = true
    file    = "${params.outdir}/pipeline_report.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_timeline.html"
}
